generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(cuid())
  role              Role
  name              String
  email             String        @unique
  phone             String?
  passwordHash      String
  isActive          Boolean       @default(true)
  lastLogin         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  accounts          Account[]
  admin             Admin?
  auditLogs         AuditLog[]
  faculty           Faculty?
  parent            Parent?
  sessions          Session[]
  sentTicketReplies TicketReply[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Parent {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  relation               String                  @default("Father")
  occupation             String?
  alertAcknowledgements  AlertAcknowledgement[]
  conversations          Conversation[]
  feeAcknowledgements    FeeAcknowledgement[]
  noticeAcknowledgements NoticeAcknowledgement[]
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentControl          ParentControl?
  sosAlerts              SOSAlert[]
  students               Student[]
  tickets                Ticket[]
}

model Admin {
  id         String  @id @default(cuid())
  userId     String  @unique
  department String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Faculty {
  id            String           @id @default(cuid())
  userId        String           @unique
  department    String
  designation   String?
  conversations Conversation[]
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects      FacultySubject[]
}

model Department {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  students Student[]
  subjects Subject[]
}

model Student {
  id                String             @id @default(cuid())
  registerNumber    String             @unique
  name              String
  departmentId      String
  year              Int
  semester          Int
  section           String
  parentId          String?
  consentStatus     ConsentStatus      @default(PENDING)
  status            StudentStatus      @default(ACTIVE)
  dateOfBirth       DateTime?
  photo             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  anomalies         Anomaly[]
  attendanceRecords AttendanceRecord[]
  campusOneAccount  CampusOneAccount?
  conversations     Conversation[]
  feeRecords        FeeRecord[]
  foodLogs          FoodLog[]
  leaveRecords      LeaveRecord[]
  locationAlerts    LocationAlert[]
  markRecords       MarkRecord[]
  notifications     Notification[]
  odTrips           ODTrip[]
  parentControl     ParentControl?
  sosAlerts         SOSAlert[]
  department        Department         @relation(fields: [departmentId], references: [id])
  parent            Parent?            @relation(fields: [parentId], references: [id])
  checkIns          StudentCheckIn[]
  tickets           Ticket[]
}

model Subject {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  semester          Int
  departmentId      String
  credits           Int                @default(3)
  attendanceRecords AttendanceRecord[]
  facultySubjects   FacultySubject[]
  markRecords       MarkRecord[]
  department        Department         @relation(fields: [departmentId], references: [id])
}

model FacultySubject {
  id        String  @id @default(cuid())
  facultyId String
  subjectId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([facultyId, subjectId])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  subjectId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  student   Student          @relation(fields: [studentId], references: [id])
  subject   Subject          @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, date])
}

model MarkRecord {
  id             String         @id @default(cuid())
  studentId      String
  subjectId      String
  assessmentType AssessmentType
  score          Float
  maxScore       Float
  remarks        String?
  publishedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  student        Student        @relation(fields: [studentId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
}

model FeeRecord {
  id               String               @id @default(cuid())
  studentId        String
  term             String
  description      String?
  totalAmount      Float
  paidAmount       Float                @default(0)
  dueDate          DateTime
  status           FeeStatus            @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  acknowledgements FeeAcknowledgement[]
  student          Student              @relation(fields: [studentId], references: [id])
}

model FeeAcknowledgement {
  id             String    @id @default(cuid())
  feeRecordId    String
  parentId       String
  acknowledgedAt DateTime  @default(now())
  feeRecord      FeeRecord @relation(fields: [feeRecordId], references: [id])
  parent         Parent    @relation(fields: [parentId], references: [id])

  @@unique([feeRecordId, parentId])
}

model LeaveRecord {
  id        String      @id @default(cuid())
  studentId String
  type      LeaveType
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String
  status    LeaveStatus @default(PENDING)
  remarks   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  student   Student     @relation(fields: [studentId], references: [id])
  odTrip    ODTrip?
}

model Notification {
  id         String               @id @default(cuid())
  targetRole Role?
  studentId  String?
  userId     String?
  type       NotificationType
  title      String
  message    String
  priority   NotificationPriority @default(MEDIUM)
  isRead     Boolean              @default(false)
  metadata   Json?
  createdAt  DateTime             @default(now())
  student    Student?             @relation(fields: [studentId], references: [id])
}

model Notice {
  id                      String                  @id @default(cuid())
  title                   String
  content                 String
  category                String
  requiresAcknowledgement Boolean                 @default(false)
  isActive                Boolean                 @default(true)
  publishedAt             DateTime                @default(now())
  expiresAt               DateTime?
  createdAt               DateTime                @default(now())
  acknowledgements        NoticeAcknowledgement[]
}

model NoticeAcknowledgement {
  id             String   @id @default(cuid())
  noticeId       String
  parentId       String
  acknowledgedAt DateTime @default(now())
  notice         Notice   @relation(fields: [noticeId], references: [id])
  parent         Parent   @relation(fields: [parentId], references: [id])

  @@unique([noticeId, parentId])
}

model EmergencyAlert {
  id               String                 @id @default(cuid())
  title            String
  message          String
  severity         AlertSeverity          @default(WARNING)
  targetScope      AlertScope             @default(INSTITUTION)
  targetDept       String?
  isActive         Boolean                @default(true)
  publishedAt      DateTime               @default(now())
  expiresAt        DateTime?
  acknowledgements AlertAcknowledgement[]
}

model AlertAcknowledgement {
  id             String         @id @default(cuid())
  alertId        String
  parentId       String
  acknowledgedAt DateTime       @default(now())
  alert          EmergencyAlert @relation(fields: [alertId], references: [id])
  parent         Parent         @relation(fields: [parentId], references: [id])

  @@unique([alertId, parentId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String
  startDate   DateTime
  endDate     DateTime?
  department  String?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Ticket {
  id          String         @id @default(cuid())
  parentId    String
  studentId   String
  category    TicketCategory
  subject     String
  description String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      Parent         @relation(fields: [parentId], references: [id])
  student     Student        @relation(fields: [studentId], references: [id])
  replies     TicketReply[]
}

model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String
  senderRole Role
  message    String
  createdAt  DateTime @default(now())
  sender     User     @relation(fields: [senderId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  Role
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model StudentCheckIn {
  id        String      @id @default(cuid())
  studentId String
  latitude  Float
  longitude Float
  label     String?
  type      CheckInType
  createdAt DateTime    @default(now())
  student   Student     @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

model GeofenceZone {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  radiusM   Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LocationAlert {
  id        String            @id @default(cuid())
  studentId String
  type      LocationAlertType
  message   String
  latitude  Float?
  longitude Float?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())
  student   Student           @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

model ODTrip {
  id              String       @id @default(cuid())
  leaveRecordId   String?      @unique
  studentId       String
  destinationName String
  destinationLat  Float
  destinationLng  Float
  radiusM         Int          @default(500)
  status          ODTripStatus @default(PENDING)
  departedAt      DateTime?
  arrivedAt       DateTime?
  returnedAt      DateTime?
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  leaveRecord     LeaveRecord? @relation(fields: [leaveRecordId], references: [id])
  student         Student      @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
}

model CampusOneAccount {
  id           String              @id @default(cuid())
  studentId    String              @unique
  campusOneId  String
  balance      Float               @default(0)
  isConnected  Boolean             @default(true)
  connectedAt  DateTime            @default(now())
  student      Student             @relation(fields: [studentId], references: [id])
  transactions CampusTransaction[]
}

model CampusTransaction {
  id            String              @id @default(cuid())
  accountId     String
  category      TransactionCategory
  vendor        String
  description   String
  amount        Float
  transactionAt DateTime
  createdAt     DateTime            @default(now())
  account       CampusOneAccount    @relation(fields: [accountId], references: [id])

  @@index([accountId, transactionAt])
}

model FoodLog {
  id        String   @id @default(cuid())
  studentId String
  mealType  MealType
  items     String
  vendor    String
  amount    Float
  loggedAt  DateTime
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId, loggedAt])
}

model SOSAlert {
  id         String    @id @default(cuid())
  studentId  String
  parentId   String
  latitude   Float?
  longitude  Float?
  message    String?
  status     SOSStatus @default(ACTIVE)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  parent     Parent    @relation(fields: [parentId], references: [id])
  student    Student   @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
  @@index([parentId, status])
}

model ParentControl {
  id                  String   @id @default(cuid())
  parentId            String   @unique
  studentId           String   @unique
  spendingLimitDaily  Float?
  spendingLimitWeekly Float?
  attendanceTarget    Int?
  curfewTime          String?
  geofenceAlerts      Boolean  @default(true)
  mealAlerts          Boolean  @default(true)
  spendingAlerts      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  parent              Parent   @relation(fields: [parentId], references: [id])
  student             Student  @relation(fields: [studentId], references: [id])
}

model Anomaly {
  id          String          @id @default(cuid())
  studentId   String
  type        AnomalyType
  severity    AnomalySeverity
  title       String
  description String
  metadata    Json?
  isRead      Boolean         @default(false)
  isDismissed Boolean         @default(false)
  detectedAt  DateTime        @default(now())
  expiresAt   DateTime?
  student     Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, type])
  @@index([studentId, detectedAt])
  @@index([studentId, isRead])
}

model Conversation {
  id            String        @id @default(cuid())
  parentId      String
  facultyId     String
  studentId     String
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  faculty       Faculty       @relation(fields: [facultyId], references: [id])
  parent        Parent        @relation(fields: [parentId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])

  @@unique([parentId, facultyId, studentId])
  @@index([parentId, lastMessageAt])
  @@index([facultyId, lastMessageAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FACULTY
  PARENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  DROPPED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  OD
  LEAVE
  HOLIDAY
}

enum AssessmentType {
  INTERNAL_1
  INTERNAL_2
  INTERNAL_3
  MODEL_EXAM
  SEMESTER_EXAM
  ASSIGNMENT
  QUIZ
  LAB
}

enum FeeStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
}

enum LeaveType {
  MEDICAL
  PERSONAL
  FAMILY
  EVENT
  OD
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  LOW_ATTENDANCE
  CONSECUTIVE_ABSENCE
  FEE_DUE
  EXAM_REMINDER
  MARKS_PUBLISHED
  LEAVE_UPDATE
  NOTICE_PUBLISHED
  EMERGENCY
  ACHIEVEMENT
  TICKET_UPDATE
  GENERAL
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  ATTENDANCE
  MARKS
  FEE
  LEAVE
  GENERAL
  EMERGENCY
  COMPLAINT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertScope {
  INSTITUTION
  DEPARTMENT
  INDIVIDUAL
}

enum ConsentStatus {
  GIVEN
  REVOKED
  PENDING
}

enum CheckInType {
  CAMPUS_ENTRY
  CAMPUS_EXIT
  MANUAL
  AUTO
}

enum LocationAlertType {
  LEFT_CAMPUS
  ARRIVED_CAMPUS
  MISSED_CHECKIN
  UNUSUAL_LOCATION
}

enum ODTripStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  RETURNED
  MISSED
}

enum TransactionCategory {
  FOOD
  STATIONERY
  PRINTING
  EVENT
  TRANSPORT
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum SOSStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum AnomalyType {
  ATTENDANCE_DROP
  SPENDING_SPIKE
  MISSED_MEALS
  UNUSUAL_LOCATION
  GRADE_DROP
  CONSECUTIVE_ABSENCE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
